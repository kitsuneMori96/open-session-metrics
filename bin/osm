#!/usr/bin/env bash
# osm — one command to bring the session-metrics web app up from any directory.
#
#   osm            build the bundle if it is stale, start the server, open the browser
#   osm open       open the browser only
#   osm stop       stop the background server
#   osm status     what is running, and how old the bundle is
#   osm logs       follow the server log
#   osm build      rebuild web/dist only
#
# The server serves web/dist itself, so "starting the web" means starting one
# process behind one URL — no separate vite dev server, no second port.
# Environment: OSM_HOME, OSM_HOST, OSM_PORT, OSM_NO_OPEN=1.

set -euo pipefail

ROOT="${OSM_HOME:-/home/kitsunemori/projects/opencode-holo-cockpit}"
HOST="${OSM_HOST:-127.0.0.1}"
PORT="${OSM_PORT:-8787}"

BROWSE_HOST="$HOST"
if [ "$HOST" = "0.0.0.0" ]; then BROWSE_HOST="127.0.0.1"; fi
URL="http://${BROWSE_HOST}:${PORT}"

DATA_DIR="$ROOT/.data"
PID_FILE="$DATA_DIR/osm.pid"
LOG_FILE="$DATA_DIR/osm.log"

log() { printf 'osm: %s\n' "$*"; }
die() { printf 'osm: %s\n' "$*" >&2; exit 1; }

# nvm lives in the shell profile, so a bare `bash -c osmosis` may start without node.
load_node() {
  command -v node >/dev/null 2>&1 && return 0
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  # shellcheck disable=SC1091
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
  command -v node >/dev/null 2>&1 || die "node not found in PATH"
}

up() { curl -fsS -m 2 -o /dev/null "$URL/api/status" 2>/dev/null; }

# Who is listening on our port, if it is our own process (ss only names those).
port_pid() {
  ss -ltnpH "sport = :$PORT" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
}

pid() {
  local p=""
  [ -f "$PID_FILE" ] && p=$(cat "$PID_FILE" 2>/dev/null || true)
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null && { printf '%s' "$p"; return 0; }
  return 1
}

build_needed() {
  local dist="$ROOT/web/dist/index.html"
  [ -f "$dist" ] || return 0
  [ -n "$(find "$ROOT/web/src" "$ROOT/web/index.html" "$ROOT/web/vite.config.ts" \
    -newer "$dist" -print -quit 2>/dev/null)" ]
}

build_web() {
  load_node
  command -v pnpm >/dev/null 2>&1 || die "pnpm not found in PATH (needed to build web/dist)"
  log "building web bundle"
  mkdir -p "$DATA_DIR"
  if ! ( cd "$ROOT" && pnpm -F @osm/web build ) >>"$LOG_FILE" 2>&1; then
    tail -20 "$LOG_FILE" >&2 || true
    die "web build failed (log: $LOG_FILE)"
  fi
}

open_browser() {
  if [ "${OSM_NO_OPEN:-0}" = "1" ]; then return 0; fi
  if command -v wslview >/dev/null 2>&1; then
    wslview "$URL" >/dev/null 2>&1 &
  elif command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe /c start "" "$URL" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL" >/dev/null 2>&1 &
  else
    log "open $URL"
  fi
}

start() {
  local running
  if running=$(pid); then
    log "already running (pid $running) — $URL"
    open_browser
    return 0
  fi
  rm -f "$PID_FILE"

  if up; then
    log "port $PORT already answers — $URL"
    open_browser
    return 0
  fi

  if build_needed; then build_web; fi

  load_node
  [ -e "$ROOT/server/node_modules/tsx" ] || die "dependencies missing — run: (cd $ROOT && pnpm install)"

  mkdir -p "$DATA_DIR"
  log "starting server"
  # One node process on purpose: tsx's CLI spawns the entry as a child, which
  # would leave the pid file pointing at a wrapper that exits.
  ( cd "$ROOT/server" && setsid nohup node --import tsx src/index.ts >>"$LOG_FILE" 2>&1 </dev/null & echo $! >"$PID_FILE" )

  local i=0
  while [ "$i" -lt 120 ]; do
    if up; then break; fi
    sleep 0.5
    i=$((i + 1))
  done
  if ! up; then
    tail -20 "$LOG_FILE" >&2 || true
    die "server did not come up (log: $LOG_FILE)"
  fi
  # Trust the socket, not the shell: the pid is only useful if it is the one
  # holding the port.
  local owner
  owner=$(port_pid)
  if [ -n "$owner" ]; then printf '%s\n' "$owner" >"$PID_FILE"; fi
  log "up — $URL"
  open_browser
}

stop() {
  local p listener i=0
  if p=$(pid); then
    # A recycled pid must not cost an unrelated process its life.
    if ! tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -q 'src/index.ts'; then
      log "pid $p is not the osm server — leaving it alone"
      rm -f "$PID_FILE"
      return 0
    fi
    kill -TERM "$p" 2>/dev/null || true
    while up && [ "$i" -lt 25 ]; do sleep 0.2; i=$((i + 1)); done
    if up; then
      kill -KILL "$p" 2>/dev/null || true
      sleep 0.5
    fi
    log "stopped (pid $p)"
  else
    log "not running"
  fi
  # A server started outside osm still holds the port; say so instead of
  # pretending the next start will be able to bind.
  if up; then
    listener=$(port_pid)
    log "port $PORT still answers${listener:+ (pid $listener, not started by osm)}"
  fi
  rm -f "$PID_FILE"
}

status() {
  local p
  if p=$(pid); then
    log "running (pid $p) — $URL"
  elif up; then
    local listener
    listener=$(port_pid)
    log "something answers on $URL${listener:+ (pid $listener)}, but not started by osm"
  else
    log "not running — $URL"
  fi
  if [ -f "$ROOT/web/dist/index.html" ]; then
    log "bundle built $(date -r "$ROOT/web/dist/index.html" '+%Y-%m-%d %H:%M')"
    if build_needed; then log "bundle is stale (web/src changed since then)"; fi
  else
    log "bundle missing — next start builds it"
  fi
}

case "${1:-start}" in
  start) start ;;
  open) open_browser; log "$URL" ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs)
    [ -f "$LOG_FILE" ] || touch "$LOG_FILE"
    tail -n "${2:-40}" -f "$LOG_FILE"
    ;;
  build) build_web; log "bundle rebuilt" ;;
  -h | --help | help)
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "unknown command: $1 (try: osm --help)" ;;
esac
