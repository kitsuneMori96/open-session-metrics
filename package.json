{
  "name": "opencode-session-metrics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Materialize OpenCode session data into a metrics store and serve it over an analytics API",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm -F @osm/server dev\" \"pnpm -F @osm/web dev\"",
    "materialize": "pnpm -F @osm/server materialize",
    "build": "pnpm -F @osm/web build",
    "start": "pnpm -F @osm/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
