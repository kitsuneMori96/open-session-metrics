{
  "name": "@kitsunemori96/open-session-metrics",
  "version": "0.3.0",
  "description": "A local-first web cockpit for coding session metrics across OpenCode and Qoder: tokens, cost, tools, and transcripts.",
  "type": "module",
  "license": "MIT",
  "author": "kitsuneMori96",
  "homepage": "https://github.com/kitsuneMori96/open-session-metrics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitsuneMori96/open-session-metrics.git"
  },
  "bugs": {
    "url": "https://github.com/kitsuneMori96/open-session-metrics/issues"
  },
  "keywords": [
    "opencode",
    "qoder",
    "session",
    "metrics",
    "analytics",
    "tokens",
    "credits",
    "cost",
    "dashboard",
    "cli"
  ],
  "bin": {
    "osm": "bin/osm.js"
  },
  "files": [
    "bin/",
    "server/dist/",
    "web/dist/"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm -F @osm/server dev\" \"pnpm -F @osm/web dev\"",
    "build": "pnpm -F @osm/web build && pnpm -F @osm/server build",
    "build:web": "pnpm -F @osm/web build",
    "build:server": "pnpm -F @osm/server build",
    "prepack": "pnpm build",
    "serve": "pnpm build && node bin/osm.js restart",
    "materialize": "pnpm -F @osm/server materialize",
    "plans": "pnpm -F @osm/server plans",
    "start": "pnpm -F @osm/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
