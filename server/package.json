{
  "name": "@osm/server",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outfile=dist/index.js --log-level=warning",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "materialize": "tsx src/cli/materialize.ts",
    "plans": "tsx src/cli/plans.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/tests/etl.ts && tsx src/tests/qoder.ts && tsx src/tests/sources.ts && tsx src/tests/invariants.ts",
    "test:smoke": "tsx src/tests/run.ts",
    "test:invariants": "tsx src/tests/invariants.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
